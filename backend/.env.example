# Credenciales de WhatsApp Business API (Meta Cloud API)
# Se consiguen en developers.facebook.com creando una app tipo "Business"
# y activando el producto "WhatsApp".
# Mientras no estén, el servidor corre en modo DEMO (el código OTP
# se imprime en la consola en vez de enviarse por WhatsApp real).
#
# El negocio maneja 2 números bajo la misma cuenta de Meta Business (WABA).
# Poner los "Phone Number ID" separados por coma, en el orden en que
# quieren que roten los leads:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_IDS=id_numero_1,id_numero_2

PORT=3001
